{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "pods.eks.amazonaws.com"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/eks-cluster-arn": "arn:aws:eks:us-east-1:762491855071:cluster/aws-ue1-litellm-eks",
          "aws:RequestTag/kubernetes-namespace": "litellm",
          "aws:RequestTag/kubernetes-service-account": "litellm"
        }
      }
    }
  ]
}

