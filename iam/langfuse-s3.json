{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LangfuseEventObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::__LANGFUSE_BUCKET__/*"
    },
    {
      "Sid": "LangfuseEventBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__LANGFUSE_BUCKET__"
    }
  ]
}
